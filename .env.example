# Production (Turso Cloud)
# Copy this file to .env and fill in your Turso credentials
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-auth-token-here

# The app always talks to Turso over HTTP and needs these. Only drizzle-kit can use a
# local file: `make db-push-local` pushes the schema to ./local.db.

# Seals the login session cookie. Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
